# Copy this file to a new file named ".env" and fill in your own values.
# The real .env file is NOT pushed to GitHub (it is listed in .gitignore).
# NEVER put real passwords or keys in this example file.

# Generate one with:  python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=replace-me-with-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Supabase (PostgreSQL) connection string.
# Supabase dashboard > Connect > "Session pooler" > copy the URI and put your DB password in it.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres
